# Copy this file to .env and fill in real values for cloud mode.
# The defaults below already work for local simulation with zero edits.

# -- General ---------------------------------------------------------------
ENVIRONMENT=development
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# -- Cloud provider switch: "local" or "supabase" --------------------------
CLOUD_PROVIDER=local

# -- Supabase (required only when CLOUD_PROVIDER=supabase) -----------------
# Get these from Supabase: Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=hobby-tracker-media

# -- Local simulation (used only when CLOUD_PROVIDER=local) ----------------
LOCAL_DATA_DIR=./sample_data/local_store
LOCAL_PERSIST=true
# Change this before ever running with ENVIRONMENT=production:
LOCAL_JWT_SECRET=dev-only-change-me

# -- Uploads -----------------------------------------------------------------
MAX_UPLOAD_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

# -- Rate limiting -------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120

# -- Optional AI hobby-suggestion microservice (not required to run the app) -
AI_SUGGEST_URL=
