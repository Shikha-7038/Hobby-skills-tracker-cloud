# The frontend talks to the FastAPI backend through relative /api paths.
# In development, vite.config.js proxies /api -> VITE_API_PROXY_TARGET.
# In production, set this to your deployed backend URL and rebuild, OR
# serve the frontend from the same domain/reverse proxy as the backend
# so relative /api paths keep working with no rebuild needed.
VITE_API_PROXY_TARGET=http://localhost:8000
